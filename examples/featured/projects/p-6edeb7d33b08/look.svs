<?svml using="@hypit/svs@1"?>
<sheet version="1">
  media.clip { stack-order: 0; fit: cover; }
  media.endcard { stack-order: 10; fit: cover; }
  motion.endcard-in { enter: fade; enter-frames: 16; enter-easing: ease-out; }
  film.main { background: #F1EEE7; }
  caption.primary {
    stack-order: 70;
    x: 0.5; y: 0.885; width: 0.8; height: 0.2;
    anchor-x: center; anchor-y: bottom;
    align: center; block-align: center; inline-size: fixed;
    wrap: word;
    size: 46; line-height: 1.25; fill: #FFFFFF;
    background: #00000000; padding: "10 24"; radius: 16;
    stroke-color: #1A1A1A99; stroke-width: 2;
    shadow-color: #000000; shadow-opacity: 0.4; shadow-x: 0; shadow-y: 2; shadow-blur: 6; shadow-spread: 0;
    karaoke: off;
    cue-enter: none; cue-exit: none;
    lead-frames: 2; tail-frames: 3; handoff: cut;
  }
  text.brand { size: 64; weight: 600; line-height: 1.0; tracking: 3; align: start; block-align: center; stack-order: 20; }
  text.tagline { size: 23; weight: 400; line-height: 1.0; tracking: 8; align: start; block-align: center; stack-order: 20; }
</sheet>
