{
  "name": "@frame/light-sweep",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "品牌字由虚到实落定，一道高光从字面扫过。",
  "hypit": {
    "activation": "./activation.js"
  },
  "frame": {
    "name": "光扫定格",
    "category": "品牌文字",
    "tags": [
      "光扫",
      "高光",
      "高级"
    ],
    "duration": 4,
    "aspectRatio": "16:9",
    "parameters": [
      {
        "key": "title",
        "label": "主标题",
        "type": "text",
        "default": "OMNICUT"
      },
      {
        "key": "subtitle",
        "label": "说明文案",
        "type": "text",
        "default": "CREATE WITHOUT LIMITS"
      },
      {
        "key": "background",
        "label": "背景颜色",
        "type": "text",
        "default": "#0f0f10"
      },
      {
        "key": "color",
        "label": "文字颜色",
        "type": "text",
        "default": "#e9e4da"
      },
      {
        "key": "accent",
        "label": "主点缀颜色",
        "type": "text",
        "default": "#ffd9a0"
      },
      {
        "key": "secondary",
        "label": "次点缀颜色",
        "type": "text",
        "default": "#8a8378"
      },
      {
        "key": "x",
        "label": "水平位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "y",
        "label": "垂直位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "scale",
        "label": "整体缩放",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 2,
        "step": 0.05
      },
      {
        "key": "speed",
        "label": "动作速度",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 3,
        "step": 0.1
      },
      {
        "key": "intensity",
        "label": "运动幅度",
        "type": "number",
        "default": 1,
        "min": 0,
        "max": 2,
        "step": 0.1
      },
      {
        "key": "transparent",
        "label": "透明背景 true / false",
        "type": "text",
        "default": "false"
      },
      {
        "key": "z",
        "label": "图层顺序",
        "type": "number",
        "default": 50,
        "step": 1
      }
    ],
    "recommendedUses": [
      "品牌片尾",
      "高端产品",
      "标志定格",
      "实拍上的可编辑叠加"
    ],
    "import": "@frame/light-sweep@1"
  }
}
