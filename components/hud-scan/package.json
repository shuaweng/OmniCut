{
  "name": "@frame/hud-scan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "环形读数与刻度旋转展开，扫描线掠过，目标锁定后显示标题。",
  "hypit": {
    "activation": "./activation.js"
  },
  "frame": {
    "name": "全息界面",
    "category": "空间图形",
    "tags": [
      "HUD",
      "全息",
      "科幻"
    ],
    "duration": 4,
    "aspectRatio": "16:9",
    "parameters": [
      {
        "key": "title",
        "label": "主标题",
        "type": "text",
        "default": "目标锁定"
      },
      {
        "key": "subtitle",
        "label": "说明文案",
        "type": "text",
        "default": "ANALYSIS COMPLETE"
      },
      {
        "key": "background",
        "label": "背景颜色",
        "type": "text",
        "default": "#020c12"
      },
      {
        "key": "color",
        "label": "文字颜色",
        "type": "text",
        "default": "#c8f7ff"
      },
      {
        "key": "accent",
        "label": "主点缀颜色",
        "type": "text",
        "default": "#2de2e6"
      },
      {
        "key": "secondary",
        "label": "次点缀颜色",
        "type": "text",
        "default": "#ff6a22"
      },
      {
        "key": "x",
        "label": "水平位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "y",
        "label": "垂直位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "scale",
        "label": "整体缩放",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 2,
        "step": 0.05
      },
      {
        "key": "speed",
        "label": "动作速度",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 3,
        "step": 0.1
      },
      {
        "key": "intensity",
        "label": "运动幅度",
        "type": "number",
        "default": 1,
        "min": 0,
        "max": 2,
        "step": 0.1
      },
      {
        "key": "transparent",
        "label": "透明背景 true / false",
        "type": "text",
        "default": "false"
      },
      {
        "key": "z",
        "label": "图层顺序",
        "type": "number",
        "default": 50,
        "step": 1
      }
    ],
    "recommendedUses": [
      "科技发布",
      "智能分析",
      "游戏开场",
      "实拍上的可编辑叠加"
    ],
    "import": "@frame/hud-scan@1"
  }
}
