{
  "name": "@frame/confetti-rain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "彩纸翻转飘落，标题弹出，适合庆祝与公告。",
  "hypit": {
    "activation": "./activation.js"
  },
  "frame": {
    "name": "彩纸飘落",
    "category": "粒子光效",
    "tags": [
      "彩纸",
      "庆祝",
      "活泼"
    ],
    "duration": 4,
    "aspectRatio": "16:9",
    "parameters": [
      {
        "key": "title",
        "label": "主标题",
        "type": "text",
        "default": "恭喜上线"
      },
      {
        "key": "subtitle",
        "label": "说明文案",
        "type": "text",
        "default": "感谢每一位同行者"
      },
      {
        "key": "background",
        "label": "背景颜色",
        "type": "text",
        "default": "#fff8ee"
      },
      {
        "key": "color",
        "label": "文字颜色",
        "type": "text",
        "default": "#2a1f1a"
      },
      {
        "key": "accent",
        "label": "主点缀颜色",
        "type": "text",
        "default": "#ff5e5b"
      },
      {
        "key": "secondary",
        "label": "次点缀颜色",
        "type": "text",
        "default": "#00a6a6"
      },
      {
        "key": "x",
        "label": "水平位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "y",
        "label": "垂直位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "scale",
        "label": "整体缩放",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 2,
        "step": 0.05
      },
      {
        "key": "speed",
        "label": "动作速度",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 3,
        "step": 0.1
      },
      {
        "key": "intensity",
        "label": "运动幅度",
        "type": "number",
        "default": 1,
        "min": 0,
        "max": 2,
        "step": 0.1
      },
      {
        "key": "transparent",
        "label": "透明背景 true / false",
        "type": "text",
        "default": "false"
      },
      {
        "key": "z",
        "label": "图层顺序",
        "type": "number",
        "default": 50,
        "step": 1
      }
    ],
    "recommendedUses": [
      "里程碑",
      "中奖公告",
      "节日",
      "实拍上的可编辑叠加"
    ],
    "import": "@frame/confetti-rain@1"
  }
}
