{
  "name": "@frame/stripe-wipe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "斜向彩色条纹依次扫过画面，擦出下一幕标题。",
  "hypit": {
    "activation": "./activation.js"
  },
  "frame": {
    "name": "条纹擦除",
    "category": "转场遮罩",
    "tags": [
      "条纹",
      "擦除",
      "转场"
    ],
    "duration": 4,
    "aspectRatio": "16:9",
    "parameters": [
      {
        "key": "title",
        "label": "主标题",
        "type": "text",
        "default": "下一幕"
      },
      {
        "key": "subtitle",
        "label": "说明文案",
        "type": "text",
        "default": "节奏切换，干净利落"
      },
      {
        "key": "background",
        "label": "背景颜色",
        "type": "text",
        "default": "#111111"
      },
      {
        "key": "color",
        "label": "文字颜色",
        "type": "text",
        "default": "#fafafa"
      },
      {
        "key": "accent",
        "label": "主点缀颜色",
        "type": "text",
        "default": "#ff6a22"
      },
      {
        "key": "secondary",
        "label": "次点缀颜色",
        "type": "text",
        "default": "#ffd23f"
      },
      {
        "key": "x",
        "label": "水平位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "y",
        "label": "垂直位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "scale",
        "label": "整体缩放",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 2,
        "step": 0.05
      },
      {
        "key": "speed",
        "label": "动作速度",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 3,
        "step": 0.1
      },
      {
        "key": "intensity",
        "label": "运动幅度",
        "type": "number",
        "default": 1,
        "min": 0,
        "max": 2,
        "step": 0.1
      },
      {
        "key": "transparent",
        "label": "透明背景 true / false",
        "type": "text",
        "default": "false"
      },
      {
        "key": "z",
        "label": "图层顺序",
        "type": "number",
        "default": 50,
        "step": 1
      }
    ],
    "recommendedUses": [
      "章节转场",
      "节目包装",
      "快节奏混剪",
      "实拍上的可编辑叠加"
    ],
    "import": "@frame/stripe-wipe@1"
  }
}
