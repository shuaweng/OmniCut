{
  "name": "@frame/ken-burns",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "照片缓慢推近并轻微平移，胶片边框与字幕一起淡入。",
  "hypit": {
    "activation": "./activation.js"
  },
  "frame": {
    "name": "照片推移",
    "category": "照片画面",
    "tags": [
      "照片",
      "推移",
      "回忆"
    ],
    "duration": 4,
    "aspectRatio": "16:9",
    "parameters": [
      {
        "key": "title",
        "label": "主标题",
        "type": "text",
        "default": "那年夏天"
      },
      {
        "key": "subtitle",
        "label": "说明文案",
        "type": "text",
        "default": "2026 · 青岛"
      },
      {
        "key": "background",
        "label": "背景颜色",
        "type": "text",
        "default": "#0c0c0c"
      },
      {
        "key": "color",
        "label": "文字颜色",
        "type": "text",
        "default": "#f5f0e6"
      },
      {
        "key": "accent",
        "label": "主点缀颜色",
        "type": "text",
        "default": "#e8c07d"
      },
      {
        "key": "secondary",
        "label": "次点缀颜色",
        "type": "text",
        "default": "#3a3530"
      },
      {
        "key": "x",
        "label": "水平位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "y",
        "label": "垂直位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "scale",
        "label": "整体缩放",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 2,
        "step": 0.05
      },
      {
        "key": "speed",
        "label": "动作速度",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 3,
        "step": 0.1
      },
      {
        "key": "intensity",
        "label": "运动幅度",
        "type": "number",
        "default": 1,
        "min": 0,
        "max": 2,
        "step": 0.1
      },
      {
        "key": "transparent",
        "label": "透明背景 true / false",
        "type": "text",
        "default": "false"
      },
      {
        "key": "z",
        "label": "图层顺序",
        "type": "number",
        "default": 50,
        "step": 1
      }
    ],
    "recommendedUses": [
      "回忆相册",
      "旅行记录",
      "人物故事",
      "实拍上的可编辑叠加"
    ],
    "import": "@frame/ken-burns@1"
  }
}
