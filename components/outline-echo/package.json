{
  "name": "@frame/outline-echo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "实体字逐步落稳，轮廓字向两侧展开成空间回声。",
  "hypit": {
    "activation": "./activation.js"
  },
  "frame": {
    "name": "轮廓回响",
    "category": "文字排版",
    "tags": [
      "轮廓",
      "回声",
      "海报"
    ],
    "duration": 4,
    "aspectRatio": "16:9",
    "parameters": [
      {
        "key": "title",
        "label": "主标题",
        "type": "text",
        "default": "敢于 想象"
      },
      {
        "key": "subtitle",
        "label": "说明文案",
        "type": "text",
        "default": "一个观点，多重回响"
      },
      {
        "key": "background",
        "label": "背景颜色",
        "type": "text",
        "default": "#f5d7cb"
      },
      {
        "key": "color",
        "label": "文字颜色",
        "type": "text",
        "default": "#792f30"
      },
      {
        "key": "accent",
        "label": "主点缀颜色",
        "type": "text",
        "default": "#cd5442"
      },
      {
        "key": "secondary",
        "label": "次点缀颜色",
        "type": "text",
        "default": "#b77270"
      },
      {
        "key": "x",
        "label": "水平位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "y",
        "label": "垂直位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "scale",
        "label": "整体缩放",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 2,
        "step": 0.05
      },
      {
        "key": "speed",
        "label": "动作速度",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 3,
        "step": 0.1
      },
      {
        "key": "intensity",
        "label": "运动幅度",
        "type": "number",
        "default": 1,
        "min": 0,
        "max": 2,
        "step": 0.1
      },
      {
        "key": "transparent",
        "label": "透明背景 true / false",
        "type": "text",
        "default": "false"
      },
      {
        "key": "z",
        "label": "图层顺序",
        "type": "number",
        "default": 50,
        "step": 1
      }
    ],
    "recommendedUses": [
      "轮廓镜头",
      "品牌与信息讲解",
      "实拍上的可编辑叠加"
    ],
    "import": "@frame/outline-echo@1"
  }
}
