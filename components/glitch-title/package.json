{
  "name": "@frame/glitch-title",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "色彩分离与切片错位的数字故障，最后稳定成清晰标题。",
  "hypit": {
    "activation": "./activation.js"
  },
  "frame": {
    "name": "故障标题",
    "category": "文字排版",
    "tags": [
      "故障",
      "RGB",
      "赛博"
    ],
    "duration": 4,
    "aspectRatio": "16:9",
    "parameters": [
      {
        "key": "title",
        "label": "主标题",
        "type": "text",
        "default": "信号已接入"
      },
      {
        "key": "subtitle",
        "label": "说明文案",
        "type": "text",
        "default": "SYSTEM ONLINE"
      },
      {
        "key": "background",
        "label": "背景颜色",
        "type": "text",
        "default": "#0a0a12"
      },
      {
        "key": "color",
        "label": "文字颜色",
        "type": "text",
        "default": "#f2f2f7"
      },
      {
        "key": "accent",
        "label": "主点缀颜色",
        "type": "text",
        "default": "#ff2e63"
      },
      {
        "key": "secondary",
        "label": "次点缀颜色",
        "type": "text",
        "default": "#08d9d6"
      },
      {
        "key": "x",
        "label": "水平位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "y",
        "label": "垂直位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "scale",
        "label": "整体缩放",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 2,
        "step": 0.05
      },
      {
        "key": "speed",
        "label": "动作速度",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 3,
        "step": 0.1
      },
      {
        "key": "intensity",
        "label": "运动幅度",
        "type": "number",
        "default": 1,
        "min": 0,
        "max": 2,
        "step": 0.1
      },
      {
        "key": "transparent",
        "label": "透明背景 true / false",
        "type": "text",
        "default": "false"
      },
      {
        "key": "z",
        "label": "图层顺序",
        "type": "number",
        "default": 50,
        "step": 1
      }
    ],
    "recommendedUses": [
      "科技开场",
      "游戏与潮流",
      "转折强调",
      "实拍上的可编辑叠加"
    ],
    "import": "@frame/glitch-title@1"
  }
}
