{
  "name": "@frame/beat-rings",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "每个节拍从中心扩散一圈圆环，重拍更亮更大。",
  "hypit": {
    "activation": "./activation.js"
  },
  "frame": {
    "name": "节拍圆环",
    "category": "音乐律动",
    "tags": [
      "圆环",
      "节拍",
      "脉冲"
    ],
    "duration": 4,
    "aspectRatio": "16:9",
    "parameters": [
      {
        "key": "title",
        "label": "主标题",
        "type": "text",
        "default": "心跳同频"
      },
      {
        "key": "subtitle",
        "label": "说明文案",
        "type": "text",
        "default": "每一拍都被看见"
      },
      {
        "key": "background",
        "label": "背景颜色",
        "type": "text",
        "default": "#101318"
      },
      {
        "key": "color",
        "label": "文字颜色",
        "type": "text",
        "default": "#eef2f6"
      },
      {
        "key": "accent",
        "label": "主点缀颜色",
        "type": "text",
        "default": "#ffd166"
      },
      {
        "key": "secondary",
        "label": "次点缀颜色",
        "type": "text",
        "default": "#ef476f"
      },
      {
        "key": "bpm",
        "label": "节拍速度 BPM",
        "type": "number",
        "default": 110,
        "min": 60,
        "max": 180,
        "step": 1
      },
      {
        "key": "x",
        "label": "水平位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "y",
        "label": "垂直位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "scale",
        "label": "整体缩放",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 2,
        "step": 0.05
      },
      {
        "key": "speed",
        "label": "动作速度",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 3,
        "step": 0.1
      },
      {
        "key": "intensity",
        "label": "运动幅度",
        "type": "number",
        "default": 1,
        "min": 0,
        "max": 2,
        "step": 0.1
      },
      {
        "key": "transparent",
        "label": "透明背景 true / false",
        "type": "text",
        "default": "false"
      },
      {
        "key": "z",
        "label": "图层顺序",
        "type": "number",
        "default": 50,
        "step": 1
      }
    ],
    "recommendedUses": [
      "音乐可视化",
      "运动健身",
      "节奏转场",
      "实拍上的可编辑叠加"
    ],
    "import": "@frame/beat-rings@1"
  }
}
