{
  "name": "@frame/stagger-cards",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "卡片先展开后错层落稳，突出信息之间的层级。",
  "hypit": {
    "activation": "./activation.js"
  },
  "frame": {
    "name": "错层卡片",
    "category": "界面产品",
    "tags": [
      "卡片",
      "错层",
      "界面"
    ],
    "duration": 4,
    "aspectRatio": "16:9",
    "parameters": [
      {
        "key": "title",
        "label": "主标题",
        "type": "text",
        "default": "每个想法 都有位置"
      },
      {
        "key": "subtitle",
        "label": "说明文案",
        "type": "text",
        "default": "把零散信息，整理成下一步"
      },
      {
        "key": "background",
        "label": "背景颜色",
        "type": "text",
        "default": "#18252e"
      },
      {
        "key": "color",
        "label": "文字颜色",
        "type": "text",
        "default": "#f0eee4"
      },
      {
        "key": "accent",
        "label": "主点缀颜色",
        "type": "text",
        "default": "#a8c5d5"
      },
      {
        "key": "secondary",
        "label": "次点缀颜色",
        "type": "text",
        "default": "#f1a36d"
      },
      {
        "key": "labels",
        "label": "卡片标题（逗号分隔）",
        "type": "text",
        "default": "收集灵感,整理思路,开始行动"
      },
      {
        "key": "x",
        "label": "水平位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "y",
        "label": "垂直位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "scale",
        "label": "整体缩放",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 2,
        "step": 0.05
      },
      {
        "key": "speed",
        "label": "动作速度",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 3,
        "step": 0.1
      },
      {
        "key": "intensity",
        "label": "运动幅度",
        "type": "number",
        "default": 1,
        "min": 0,
        "max": 2,
        "step": 0.1
      },
      {
        "key": "transparent",
        "label": "透明背景 true / false",
        "type": "text",
        "default": "false"
      },
      {
        "key": "z",
        "label": "图层顺序",
        "type": "number",
        "default": 50,
        "step": 1
      }
    ],
    "recommendedUses": [
      "卡片镜头",
      "品牌与信息讲解",
      "实拍上的可编辑叠加"
    ],
    "import": "@frame/stagger-cards@1"
  }
}
