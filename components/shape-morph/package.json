{
  "name": "@frame/shape-morph",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "圆形、方形、星形依次平滑变形，最后定格为标题徽章。",
  "hypit": {
    "activation": "./activation.js"
  },
  "frame": {
    "name": "形状变形",
    "category": "几何图形",
    "tags": [
      "变形",
      "形状",
      "转化"
    ],
    "duration": 4,
    "aspectRatio": "16:9",
    "parameters": [
      {
        "key": "title",
        "label": "主标题",
        "type": "text",
        "default": "形随意动"
      },
      {
        "key": "subtitle",
        "label": "说明文案",
        "type": "text",
        "default": "一个形状，多种可能"
      },
      {
        "key": "background",
        "label": "背景颜色",
        "type": "text",
        "default": "#eef0f2"
      },
      {
        "key": "color",
        "label": "文字颜色",
        "type": "text",
        "default": "#1a1d21"
      },
      {
        "key": "accent",
        "label": "主点缀颜色",
        "type": "text",
        "default": "#3d5afe"
      },
      {
        "key": "secondary",
        "label": "次点缀颜色",
        "type": "text",
        "default": "#ff6a22"
      },
      {
        "key": "x",
        "label": "水平位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "y",
        "label": "垂直位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "scale",
        "label": "整体缩放",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 2,
        "step": 0.05
      },
      {
        "key": "speed",
        "label": "动作速度",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 3,
        "step": 0.1
      },
      {
        "key": "intensity",
        "label": "运动幅度",
        "type": "number",
        "default": 1,
        "min": 0,
        "max": 2,
        "step": 0.1
      },
      {
        "key": "transparent",
        "label": "透明背景 true / false",
        "type": "text",
        "default": "false"
      },
      {
        "key": "z",
        "label": "图层顺序",
        "type": "number",
        "default": 50,
        "step": 1
      }
    ],
    "recommendedUses": [
      "概念转化",
      "品牌图形",
      "过渡镜头",
      "实拍上的可编辑叠加"
    ],
    "import": "@frame/shape-morph@1"
  }
}
