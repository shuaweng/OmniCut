{
  "name": "@frame/code-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "编辑器窗口里代码按行出现并高亮，右侧实时预览随之生长。",
  "hypit": {
    "activation": "./activation.js"
  },
  "frame": {
    "name": "代码编辑器",
    "category": "代码终端",
    "tags": [
      "代码",
      "编辑器",
      "高亮"
    ],
    "duration": 4,
    "aspectRatio": "16:9",
    "parameters": [
      {
        "key": "title",
        "label": "主标题",
        "type": "text",
        "default": "代码即画面"
      },
      {
        "key": "subtitle",
        "label": "说明文案",
        "type": "text",
        "default": "每一帧都可编辑"
      },
      {
        "key": "background",
        "label": "背景颜色",
        "type": "text",
        "default": "#1e1f24"
      },
      {
        "key": "color",
        "label": "文字颜色",
        "type": "text",
        "default": "#d4d7de"
      },
      {
        "key": "accent",
        "label": "主点缀颜色",
        "type": "text",
        "default": "#ff9e64"
      },
      {
        "key": "secondary",
        "label": "次点缀颜色",
        "type": "text",
        "default": "#7aa2f7"
      },
      {
        "key": "x",
        "label": "水平位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "y",
        "label": "垂直位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "scale",
        "label": "整体缩放",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 2,
        "step": 0.05
      },
      {
        "key": "speed",
        "label": "动作速度",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 3,
        "step": 0.1
      },
      {
        "key": "intensity",
        "label": "运动幅度",
        "type": "number",
        "default": 1,
        "min": 0,
        "max": 2,
        "step": 0.1
      },
      {
        "key": "transparent",
        "label": "透明背景 true / false",
        "type": "text",
        "default": "false"
      },
      {
        "key": "z",
        "label": "图层顺序",
        "type": "number",
        "default": 50,
        "step": 1
      }
    ],
    "recommendedUses": [
      "开发者产品",
      "技术讲解",
      "代码动效介绍",
      "实拍上的可编辑叠加"
    ],
    "import": "@frame/code-editor@1"
  }
}
