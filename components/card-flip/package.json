{
  "name": "@frame/card-flip",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "三张卡片依次三维翻转，背面揭晓图片与卖点。",
  "hypit": {
    "activation": "./activation.js"
  },
  "frame": {
    "name": "卡片翻转",
    "category": "界面产品",
    "tags": [
      "翻转",
      "卡片",
      "揭晓"
    ],
    "duration": 4,
    "aspectRatio": "16:9",
    "parameters": [
      {
        "key": "title",
        "label": "主标题",
        "type": "text",
        "default": "翻开就是答案"
      },
      {
        "key": "subtitle",
        "label": "说明文案",
        "type": "text",
        "default": "三个理由，选择我们"
      },
      {
        "key": "background",
        "label": "背景颜色",
        "type": "text",
        "default": "#121212"
      },
      {
        "key": "color",
        "label": "文字颜色",
        "type": "text",
        "default": "#f2f2f2"
      },
      {
        "key": "accent",
        "label": "主点缀颜色",
        "type": "text",
        "default": "#ff6a22"
      },
      {
        "key": "secondary",
        "label": "次点缀颜色",
        "type": "text",
        "default": "#2b2b2b"
      },
      {
        "key": "labels",
        "label": "卡片文字（逗号分隔）",
        "type": "text",
        "default": "更快,更美,更省心"
      },
      {
        "key": "x",
        "label": "水平位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "y",
        "label": "垂直位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "scale",
        "label": "整体缩放",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 2,
        "step": 0.05
      },
      {
        "key": "speed",
        "label": "动作速度",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 3,
        "step": 0.1
      },
      {
        "key": "intensity",
        "label": "运动幅度",
        "type": "number",
        "default": 1,
        "min": 0,
        "max": 2,
        "step": 0.1
      },
      {
        "key": "transparent",
        "label": "透明背景 true / false",
        "type": "text",
        "default": "false"
      },
      {
        "key": "z",
        "label": "图层顺序",
        "type": "number",
        "default": 50,
        "step": 1
      }
    ],
    "recommendedUses": [
      "卖点揭晓",
      "对比展示",
      "抽卡互动",
      "实拍上的可编辑叠加"
    ],
    "import": "@frame/card-flip@1"
  }
}
