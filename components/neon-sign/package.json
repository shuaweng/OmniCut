      "灯牌",
      "夜景"
    ],
    "duration": 4,
    "aspectRatio": "16:9",
    "parameters": [
      {
        "key": "title",
        "label": "主标题",
        "type": "text",
        "default": "今夜营业"
      },
      {
        "key": "subtitle",
        "label": "说明文案",
        "type": "text",
        "default": "OPEN ALL NIGHT"
      },
      {
        "key": "background",
        "label": "背景颜色",
        "type": "text",
        "default": "#0b0614"
      },
      {
        "key": "color",
        "label": "文字颜色",
        "type": "text",
        "default": "#ffe9fb"
      },
      {
        "key": "accent",
        "label": "主点缀颜色",
        "type": "text",
        "default": "#ff3fd1"
      },
      {
        "key": "secondary",
        "label": "次点缀颜色",
        "type": "text",
        "default": "#4d2bff"
