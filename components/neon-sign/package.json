{
  "name": "@frame/neon-sign",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "灯管闪烁通电，霓虹字点亮并带出墙面泛光。",
  "hypit": {
    "activation": "./activation.js"
  },
  "frame": {
