{
  "name": "@frame/cursor-click",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "光标移到输入框、打字、点击生成，结果卡片随之出现。",
  "hypit": {
    "activation": "./activation.js"
  },
  "frame": {
    "name": "光标点击演示",
    "category": "界面产品",
    "tags": [
      "光标",
      "点击",
      "操作演示"
    ],
    "duration": 4,
    "aspectRatio": "16:9",
    "parameters": [
      {
        "key": "title",
        "label": "主标题",
        "type": "text",
        "default": "输入想法，一键生成"
      },
      {
        "key": "subtitle",
        "label": "说明文案",
        "type": "text",
        "default": "三步完成创作"
      },
      {
        "key": "background",
        "label": "背景颜色",
        "type": "text",
        "default": "#f4f5f7"
      },
      {
        "key": "color",
        "label": "文字颜色",
        "type": "text",
        "default": "#16181d"
      },
      {
        "key": "accent",
        "label": "主点缀颜色",
        "type": "text",
        "default": "#ff6a22"
      },
      {
        "key": "secondary",
        "label": "次点缀颜色",
        "type": "text",
        "default": "#c9ced6"
      },
      {
        "key": "prompt",
        "label": "输入框文字",
        "type": "text",
        "default": "做一条 30 秒的新品广告"
      },
      {
        "key": "button",
        "label": "按钮文字",
        "type": "text",
        "default": "生成"
      },
      {
        "key": "x",
        "label": "水平位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "y",
        "label": "垂直位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "scale",
        "label": "整体缩放",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 2,
        "step": 0.05
      },
      {
        "key": "speed",
        "label": "动作速度",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 3,
        "step": 0.1
      },
      {
        "key": "intensity",
        "label": "运动幅度",
        "type": "number",
        "default": 1,
        "min": 0,
        "max": 2,
        "step": 0.1
      },
      {
        "key": "transparent",
        "label": "透明背景 true / false",
        "type": "text",
        "default": "false"
      },
      {
        "key": "z",
        "label": "图层顺序",
        "type": "number",
        "default": 50,
        "step": 1
      }
    ],
    "recommendedUses": [
      "软件演示",
      "AI 产品",
      "操作教程",
      "实拍上的可编辑叠加"
    ],
    "import": "@frame/cursor-click@1"
  }
}
