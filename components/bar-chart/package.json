{
  "name": "@frame/bar-chart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "数据柱错峰生长，刻度、数值和类别同步可读。",
  "hypit": {
    "activation": "./activation.js"
  },
  "frame": {
    "name": "柱形生长",
    "category": "数据图表",
    "tags": [
      "柱图",
      "数据",
      "对比"
    ],
    "duration": 4,
    "aspectRatio": "16:9",
    "parameters": [
      {
        "key": "title",
        "label": "主标题",
        "type": "text",
        "default": "增长 看得见"
      },
      {
        "key": "subtitle",
        "label": "说明文案",
        "type": "text",
        "default": "四个阶段，一条向上的路径"
      },
      {
        "key": "background",
        "label": "背景颜色",
        "type": "text",
        "default": "#112127"
      },
      {
        "key": "color",
        "label": "文字颜色",
        "type": "text",
        "default": "#e7eee6"
      },
      {
        "key": "accent",
        "label": "主点缀颜色",
        "type": "text",
        "default": "#79cbb8"
      },
      {
        "key": "secondary",
        "label": "次点缀颜色",
        "type": "text",
        "default": "#eea279"
      },
      {
        "key": "values",
        "label": "数据值（逗号分隔）",
        "type": "text",
        "default": "28,46,68,92"
      },
      {
        "key": "labels",
        "label": "类别（逗号分隔）",
        "type": "text",
        "default": "起步,成长,突破,现在"
      },
      {
        "key": "x",
        "label": "水平位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "y",
        "label": "垂直位置 %",
        "type": "number",
        "default": 50,
        "min": -50,
        "max": 150,
        "step": 1
      },
      {
        "key": "scale",
        "label": "整体缩放",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 2,
        "step": 0.05
      },
      {
        "key": "speed",
        "label": "动作速度",
        "type": "number",
        "default": 1,
        "min": 0.25,
        "max": 3,
        "step": 0.1
      },
      {
        "key": "transparent",
        "label": "透明背景 true / false",
        "type": "text",
        "default": "false"
      },
      {
        "key": "z",
        "label": "图层顺序",
        "type": "number",
        "default": 50,
        "step": 1
      }
    ],
    "recommendedUses": [
      "柱图镜头",
      "品牌与信息讲解",
      "实拍上的可编辑叠加"
    ],
    "import": "@frame/bar-chart@1"
  }
}
