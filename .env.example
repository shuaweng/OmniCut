# API Key 可在 OmniCut 模型设置中填写；不要提交或发送到聊天。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 主力执行模型：deepseek 保留原配置；anthropic 使用 Claude 原生接口。
AGENT_PROVIDER=deepseek
AGENT_MODEL=claude-sonnet-5-5
# creative 复用创意服务的连接，不改变 CREATIVE_MODEL；independent 使用下方独立连接。
AGENT_KEY_SOURCE=creative
AGENT_API_KEY=
AGENT_BASE_URL=https://api.anthropic.com
AGENT_CONTEXT_WINDOW=393216
AGENT_MAX_TOKENS=32768
AGENT_REASONING_EFFORT=high
# 本机工作台端口
PORT=5180

# 火山方舟：视频、图片与理解共用 API Key
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=

SEEDREAM_MODEL=doubao-seedream-5-0-flash-260915
ARK_VISION_MODEL=doubao-seed-2-0-mini-260428

# ElevenLabs：独立配音、纯音乐与音效
ELEVENLABS_API_KEY=
ELEVENLABS_SPEECH_MODEL=eleven_v3
ELEVENLABS_MUSIC_MODEL=music_v2_5
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# 小米 MiMo：配音、声音设计与音色复用（可选）
MIMO_API_KEY=
MIMO_VOICE=mimo_default
SPEECH_PROVIDER=elevenlabs

# Hypit 原生扩展，仅在需要这些云服务时选择；已有火山/配音服务不依赖它们。
HYPIT_GATEWAY=none
HYPIT_WHISPERX=disabled
HYPIT_HIAPI_API_KEY=
HYPIT_BEATAPI_API_KEY=
HYPIT_MONID_API_KEY=
HYPIT_POLLO_API_KEY=
HYPIT_TOKENDANCE_API_KEY=
HYPIT_HYPIHUB_API_KEY=

# MiniMax official API (cn / global). Music 3.0 requires an existing eligible account.
MINIMAX_API_KEY=
MINIMAX_REGION=cn
MINIMAX_VIDEO_MODEL=MiniMax-H3
MINIMAX_SPEECH_MODEL=speech-2.8-hd
MINIMAX_MUSIC_MODEL=music-3.0
MINIMAX_VOICE_ID=male-qn-qingse
VIDEO_PROVIDER=seedance
MUSIC_PROVIDER=elevenlabs

# 创意与理解：创意导演、参考视频抽帧理解与方案评审，共用网关 Key
CREATIVE_API_KEY=
CREATIVE_BASE_URL=
CREATIVE_MODEL=claude-opus-5-5
CREATIVE_PROTOCOL=anthropic-messages
CREATIVE_ENABLED=enabled
# 导演委派的文字简报上限（UTF-8 字节），不是模型上下文或输出上限。
CREATIVE_BRIEF_MAX_BYTES=30000

# 视频理解：默认沿用创意模型的关键帧与转录流程。
# 选择 gemini 后，参考分析和审片会发送视频（保留音轨）。
VIDEO_UNDERSTANDING_PROVIDER=creative
# 成片审片单独选服务；留空时沿用参考理解服务。Gemini 接收视频与音轨。
VIDEO_REVIEW_PROVIDER=
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Right Code 等原生流式渠道填 stream，标准 Gemini 接口填 generate。
GEMINI_API_MODE=generate

# RunningHub：共享 API Key，图像和视频共用
RUNNINGHUB_API_KEY=
RUNNINGHUB_IMAGE_MODEL=seedream-v5-pro
RUNNINGHUB_VIDEO_MODEL=minimax-h3-rh-enhanced
IMAGE_PROVIDER=seedream

# Musk API：图片生成与参考图编辑
MUSK_API_KEY=
MUSK_IMAGE_MODEL=gpt-image-2.5-sunburst

# 快跑图像服务使用官方专用 v1 接口；模型可选 1k / 2k / 4k。
KUAIPAO_API_KEY=
KUAIPAO_IMAGE_MODEL=gpt-image-2.5-2k
